# Railway Environment Variables
# Set these in Railway dashboard → Variables for your DevAI Studio service
#
# ALL of the EXPO_PUBLIC_* variables MUST be set in Railway.
# They are inlined into the JavaScript bundle at build time and
# are required for Rork AI agents, API communication, and auth.

# ── Rork Platform (REQUIRED) ──────────────────────────────
EXPO_PUBLIC_PROJECT_ID=sqyzvx036izu9xcnewxg8
EXPO_PUBLIC_RORK_API_BASE_URL=https://api.rork.com
EXPO_PUBLIC_RORK_APP_KEY=your_app_key_here
EXPO_PUBLIC_RORK_AUTH_URL=https://auth.rork.com
EXPO_PUBLIC_RORK_FUNCTIONS_URL=https://functions.rork.com
EXPO_PUBLIC_RORK_TOOLKIT_SECRET_KEY=your_toolkit_secret_key_here
EXPO_PUBLIC_TEAM_ID=your_team_id_here
EXPO_PUBLIC_TOOLKIT_URL=https://toolkit.rork.com

# ── Server ────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Health check endpoints (comma-separated, optional) ────
# HEALTH_ENDPOINTS=https://httpbin.org/get,https://dns.google/resolve?name=example.com&type=A
